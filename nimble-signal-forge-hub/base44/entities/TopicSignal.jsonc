{
  "name": "TopicSignal",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "value": {
      "type": "number"
    },
    "momentum": {
      "type": "number",
      "default": 0
    },
    "anomaly_flag": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "topic_id",
    "value"
  ]
}