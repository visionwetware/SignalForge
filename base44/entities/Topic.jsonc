{
  "name": "Topic",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "politics",
        "tech",
        "science",
        "culture",
        "finance",
        "health",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string"
    },
    "current_value": {
      "type": "number",
      "default": 0
    },
    "momentum": {
      "type": "number",
      "default": 0,
      "description": "Rate of change"
    },
    "trend_direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "flat"
      ],
      "default": "flat"
    },
    "anomaly_flag": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}