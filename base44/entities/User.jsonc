{
  "name": "User",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "premium"
      ],
      "default": "free",
      "description": "Subscription tier"
    },
    "preferred_language": {
      "type": "string",
      "default": "en"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light"
    },
    "scans_this_month": {
      "type": "number",
      "default": 0
    }
  }
}